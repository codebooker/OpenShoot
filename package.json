{
  "name": "openshoot",
  "version": "0.7.0",
  "private": true,
  "description": "Local photo culling and editing desktop workspace",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && node scripts/package.mjs",
    "prestart": "node scripts/ensure-runtime.mjs",
    "predev": "node scripts/ensure-runtime.mjs",
    "prepackage": "node scripts/ensure-runtime.mjs",
    "build:raw": "node scripts/build-raw.mjs",
    "dmg": "node scripts/dmg.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^44.9.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/codebooker/OpenShoot",
  "repository": {
    "type": "git",
    "url": "https://github.com/codebooker/OpenShoot.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
